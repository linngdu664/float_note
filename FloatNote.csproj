<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**;obj\**;artifacts\**" />
    <Page Remove="bin\**;obj\**;artifacts\**" />
    <ApplicationDefinition Remove="bin\**;obj\**;artifacts\**" />
    <EmbeddedResource Remove="bin\**;obj\**;artifacts\**" />
    <None Remove="bin\**;obj\**;artifacts\**" />
  </ItemGroup>

</Project>
