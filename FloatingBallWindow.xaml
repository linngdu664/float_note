<Window x:Class="FloatNote.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浮签入口"
        Width="54"
        Height="54"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border x:Name="Shell"
            Width="54"
            Height="54"
            CornerRadius="27"
            Background="{DynamicResource AccentBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown"
            MouseMove="Shell_MouseMove"
            MouseLeftButtonUp="Shell_MouseLeftButtonUp"
            MouseEnter="Shell_MouseEnter"
            MouseLeave="Shell_MouseLeave"
            MouseRightButtonUp="Shell_MouseRightButtonUp">
    </Border>
</Window>
