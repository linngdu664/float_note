<Window x:Class="FloatNote.CurrentTodosPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="当前代办"
        Icon="Assets/floatnote.ico"
        Width="340"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            RenderTransformOrigin="0.5,0"
            MouseLeftButtonDown="Preview_MouseLeftButtonDown"
            MouseLeave="Preview_MouseLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PreviewTranslate" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.18"
                              Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="当前代办"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding CurrentTodos}"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="450"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="8"
                                CornerRadius="7"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
