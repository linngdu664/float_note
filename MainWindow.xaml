<Window x:Class="FloatNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="浮签"
        Icon="Assets/floatnote.ico"
        Width="520"
        Height="760"
        MinWidth="420"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border x:Name="MainChrome"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Background="{DynamicResource WindowBackgroundBrush}"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="MainChromeTranslate" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentSoftBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="浮签"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{Binding NoteToggleButtonText}"
                                MinWidth="74"
                                MinHeight="26"
                                Padding="8,0"
                                Margin="0,0,6,0"
                                Command="{Binding ToggleNoteCollapsedCommand}" />
                        <Button Content="{Binding ThemeButtonText}"
                                MinWidth="54"
                                MinHeight="26"
                                Padding="8,0"
                                Margin="0,0,6,0"
                                Command="{Binding ToggleThemeCommand}" />
                        <Button Content="-"
                                Width="30"
                                MinHeight="26"
                                Padding="0"
                                Margin="0,0,4,0"
                                ToolTip="隐藏"
                                Click="HideButton_Click" />
                        <Button Content="x"
                                Width="30"
                                MinHeight="26"
                                Padding="0"
                                ToolTip="退出程序"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="NoteRow" Height="1*" MinHeight="140" />
                    <RowDefinition x:Name="NoteSplitterRow" Height="8" />
                    <RowDefinition Height="1.65*" />
                </Grid.RowDefinitions>

                <Grid x:Name="NoteHost" Grid.Row="0">
                    <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             Padding="8,8,8,42"
                             SpellCheck.IsEnabled="True" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,10,10">
                        <Button Content="反转义"
                                MinHeight="26"
                                Padding="8,0"
                                Margin="0,0,6,0"
                                ToolTip="字符串反转义：把 \n、\t 等文本转换为真实换行和制表符"
                                Command="{Binding UnescapeNoteTextCommand}" />
                        <Button Content="JSON"
                                MinHeight="26"
                                Padding="8,0"
                                ToolTip="JSON 格式化：解析后添加换行和缩进"
                                Command="{Binding FormatNoteJsonCommand}" />
                    </StackPanel>
                </Grid>

                <GridSplitter x:Name="NoteSplitter"
                              Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="{DynamicResource AccentSoftBrush}"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              ShowsPreview="True" />

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="待办"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" />
                            <CheckBox Grid.Column="1"
                                      Content="显示已完成"
                                      IsChecked="{Binding ShowCompletedTodos}"
                                      FontSize="12" />
                        </Grid>

                        <ListBox x:Name="TodoListBox"
                                 Grid.Row="2"
                                 ItemsSource="{Binding VisibleTodos}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AllowDrop="True"
                                 DragOver="TodoListBox_DragOver"
                                 Drop="TodoListBox_Drop"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TodoCard"
                                            Margin="0,0,0,8"
                                            Padding="0"
                                            CornerRadius="8"
                                            PreviewMouseLeftButtonDown="TodoCard_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="TodoCard_PreviewMouseLeftButtonUp"
                                            MouseMove="TodoCard_MouseMove"
                                            DragEnter="TodoCard_DragEnter"
                                            Drop="TodoCard_Drop"
                                            AllowDrop="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="10"
                                                                          ShadowDepth="2"
                                                                          Opacity="0.08"
                                                                          Color="#FF000000" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="14"
                                                                                  ShadowDepth="3"
                                                                                  Opacity="0.14"
                                                                                  Color="#FF000000" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                                    <Border x:Name="CurrentBar"
                                                            CornerRadius="8,0,0,8"
                                                            Background="Transparent" />

                                            <Grid Grid.Column="1" Margin="9">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid MouseLeftButtonUp="TodoHeader_MouseLeftButtonUp"
                                                      Cursor="Hand">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsCompleted}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button x:Name="CurrentButton"
                                                            Grid.Column="2"
                                                            Content="当前"
                                                            Margin="8,0,0,0"
                                                            MinHeight="24"
                                                            Padding="8,0"
                                                            FontSize="11"
                                                            ToolTip="标记或取消当前待办"
                                                            Command="{Binding DataContext.ToggleCurrentTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />

                                                    <Button Grid.Column="3"
                                                            Content="删除"
                                                            Margin="8,0,0,0"
                                                            MinHeight="24"
                                                            Padding="8,0"
                                                            Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>

                                                <Grid Grid.Row="1"
                                                      Margin="24,10,0,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0"
                                                                                                 To="1"
                                                                                                 Duration="0:0:0.14" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="6" />
                                                        <RowDefinition Height="Auto" MinHeight="150" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             FontWeight="SemiBold" />

                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             MinHeight="150"
                                                             VerticalScrollBarVisibility="Auto" />

                                                    <StackPanel Grid.Row="4" Orientation="Vertical">
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=创建时间：{0:yyyy-MM-dd HH:mm}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding CompletedAt, StringFormat=完成时间：{0:yyyy-MM-dd HH:mm}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="CurrentBar" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="TodoCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="CurrentButton" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="CurrentButton" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="CurrentButton" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="NewTodoTextBox_KeyDown"
                                     MinHeight="32" />
                            <Button Grid.Column="2"
                                    Content="添加"
                                    MinWidth="64"
                                    Command="{Binding AddTodoCommand}" />
                            <TextBox Grid.Row="2"
                                     Grid.ColumnSpan="3"
                                     Text="{Binding NewTodoContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="70"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="Ctrl + Alt + N 显示/隐藏"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>
    </Border>
</Window>
